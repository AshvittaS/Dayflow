# ── Environment ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dayflow
DB_USER=root
DB_PASSWORD=yourpassword

# Generate a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h

PORT=4000

# bcrypt cost factor (10 is good for dev, 12 for prod)
BCRYPT_ROUNDS=10

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
